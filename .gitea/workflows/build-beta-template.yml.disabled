# Disabled beta build workflow template.
#
# To use:
# 1. Copy or rename this file to: .gitea/workflows/build-beta-branch.yml
# 2. Change BRANCH_TO_BUILD below to your target branch name.
# 3. Commit and push the enabled .yml file on that branch.
#
# While this file ends in .disabled, Gitea will ignore it.

name: Build Beta Plugins Template

on:
  push:
    branches:
      - BRANCH_TO_BUILD

jobs:
  build-test-plugins:
    runs-on: ubuntu-latest
    container:
      volumes:
        - /mnt/user/appdata/KamiTasks:/KamiTasks
    steps:
      - name: Send Discord Start Notification
        run: |
          curl -X POST \
            -H "Content-Type: application/json" \
            -d '{
              "content": "Wave Link test build started on Gitea",
              "embeds": [
                {
                  "title": "Wave Link Test Build Started",
                  "description": "Test build process **started** on Gitea",
                  "color": 3447003,
                  "fields": [
                    {
                      "name": "Repository",
                      "value": "'${{ github.repository }}'",
                      "inline": true
                    },
                    {
                      "name": "Branch",
                      "value": "'${{ github.ref }}'",
                      "inline": true
                    },
                    {
                      "name": "Commit",
                      "value": "'${{ github.sha }}'",
                      "inline": true
                    }
                  ],
                  "timestamp": "'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"
                }
              ]
            }' \
            ${{ secrets.DISCORD_WEBHOOK_URL }}

      - uses: actions/checkout@v4

      - name: Setup .NET 10
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '10.0.x'

      - name: Restore dependencies
        run: dotnet restore

      - name: Build
        run: dotnet build --no-restore

      - name: Publish win x64
        run: dotnet publish WaveLink.Plugin/WaveLink.Plugin.csproj -c Release -o ./publish/win_x64/WaveLinkPlugin -r win-x64 --self-contained

      - name: Publish mac x64
        run: dotnet publish WaveLink.Plugin/WaveLink.Plugin.csproj -c Release -o ./publish/osx_x64/WaveLinkPlugin -r osx-x64 --self-contained

      - name: Publish mac arm
        run: dotnet publish WaveLink.Plugin/WaveLink.Plugin.csproj -c Release -o ./publish/osx_arm64/WaveLinkPlugin -r osx-arm64 --self-contained

      - name: Compute beta tag
        id: buildmeta
        run: |
          VERSION=$(jq -r '.version' WaveLink.Plugin/entry.tp)
          PATCH=$((VERSION % 10))
          MINOR=$(((VERSION / 10) % 10))
          MAJOR=$((VERSION / 100))
          SHORT_SHA=$(printf '%s' "${GITHUB_SHA}" | cut -c1-7)
          TAG="v${MAJOR}.${MINOR}.${PATCH}-beta.${SHORT_SHA}"
          echo "TAG=$TAG" >> "$GITHUB_OUTPUT"

      - name: Show beta tag
        run: |
          echo "TAG=${{ steps.buildmeta.outputs.TAG }}"

      - name: Zip win x64 (named folder)
        run: |
          cd publish/win_x64
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_win_x64.tpp WaveLinkPlugin -x "*.pdb" "entry2.tp" "start_plugin-2.sh"
          mv WaveLinkPlugin/entry.tp WaveLinkPlugin/entry1.tp
          mv WaveLinkPlugin/appsettings.json WaveLinkPlugin/appsettings1.json
          mv WaveLinkPlugin/entry2.tp WaveLinkPlugin/entry.tp
          mv WaveLinkPlugin/appsettings2.json WaveLinkPlugin/appsettings.json
          mv WaveLinkPlugin/WaveLink.Plugin.exe WaveLinkPlugin/WaveLink.Plugin-2.exe
          mv WaveLinkPlugin WaveLinkPlugin-2
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_win_x64_multi.tpp WaveLinkPlugin-2 -x "*.pdb" "entry1.tp" "start_plugin.sh"

      - name: Zip osx x64
        run: |
          cd publish/osx_x64
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_x64.tpp WaveLinkPlugin -x "*.pdb" "entry2.tp" "start_plugin-2.sh"
          mv WaveLinkPlugin/entry.tp WaveLinkPlugin/entry1.tp
          mv WaveLinkPlugin/appsettings.json WaveLinkPlugin/appsettings1.json
          mv WaveLinkPlugin/entry2.tp WaveLinkPlugin/entry.tp
          mv WaveLinkPlugin/appsettings2.json WaveLinkPlugin/appsettings.json
          mv WaveLinkPlugin/WaveLink.Plugin WaveLinkPlugin/WaveLink.Plugin-2
          mv WaveLinkPlugin WaveLinkPlugin-2
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_x64_multi.tpp WaveLinkPlugin-2 -x "*.pdb" "entry1.tp" "start_plugin.sh"

      - name: Zip osx arm64
        run: |
          cd publish/osx_arm64
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_arm64.tpp WaveLinkPlugin -x "*.pdb" "entry2.tp" "start_plugin-2.sh"
          mv WaveLinkPlugin/entry.tp WaveLinkPlugin/entry1.tp
          mv WaveLinkPlugin/appsettings.json WaveLinkPlugin/appsettings1.json
          mv WaveLinkPlugin/entry2.tp WaveLinkPlugin/entry.tp
          mv WaveLinkPlugin/appsettings2.json WaveLinkPlugin/appsettings.json
          mv WaveLinkPlugin/WaveLink.Plugin WaveLinkPlugin/WaveLink.Plugin-2
          mv WaveLinkPlugin WaveLinkPlugin-2
          zip -r ../../WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_arm64_multi.tpp WaveLinkPlugin-2 -x "*.pdb" "entry1.tp" "start_plugin.sh"

      - name: Create beta tag
        run: |
          git tag ${{ steps.buildmeta.outputs.TAG }}
          git push origin tag ${{ steps.buildmeta.outputs.TAG }}

      - name: Create Gitea Beta Release
        uses: akkuman/gitea-release-action@v1
        with:
          tag_name: ${{ steps.buildmeta.outputs.TAG }}
          name: Wave Link Plugin ${{ steps.buildmeta.outputs.TAG }}
          prerelease: true
          token: ${{ secrets.GITEA_TOKEN }}
          files: |
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_win_x64.tpp
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_x64.tpp
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_arm64.tpp
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_win_x64_multi.tpp
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_x64_multi.tpp
            WaveLinkPlugin_${{ steps.buildmeta.outputs.TAG }}_osx_arm64_multi.tpp

      - name: Handle Build Failure
        if: failure()
        run: |
          curl -X POST \
            -H "Content-Type: application/json" \
            -d '{
              "content": "Wave Link test build failed on Gitea",
              "embeds": [
                {
                  "title": "Wave Link Test Build Failed",
                  "description": "Test build process **failed** on Gitea",
                  "color": 15158332,
                  "fields": [
                    {
                      "name": "Repository",
                      "value": "'${{ github.repository }}'",
                      "inline": true
                    },
                    {
                      "name": "Branch",
                      "value": "'${{ github.ref }}'",
                      "inline": true
                    },
                    {
                      "name": "Commit",
                      "value": "'${{ github.sha }}'",
                      "inline": true
                    }
                  ],
                  "timestamp": "'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"
                }
              ]
            }' \
            ${{ secrets.DISCORD_WEBHOOK_URL }}

      - name: Send Discord End Notification
        if: success()
        run: |
          curl -X POST \
            -H "Content-Type: application/json" \
            -d '{
              "content": "Wave Link test build finished on Gitea",
              "embeds": [
                {
                  "title": "Wave Link Test Build Finished",
                  "description": "Test build process **finished** on Gitea. Beta prerelease created for this commit.",
                  "color": 5763719,
                  "fields": [
                    {
                      "name": "Repository",
                      "value": "'${{ github.repository }}'",
                      "inline": true
                    },
                    {
                      "name": "Branch",
                      "value": "'${{ github.ref }}'",
                      "inline": true
                    },
                    {
                      "name": "Commit",
                      "value": "'${{ github.sha }}'",
                      "inline": true
                    }
                  ],
                  "timestamp": "'$(date -u +%Y-%m-%dT%H:%M:%SZ)'"
                }
              ]
            }' \
            ${{ secrets.DISCORD_WEBHOOK_URL }}
