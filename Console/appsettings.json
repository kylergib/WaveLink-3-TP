{
  "WaveLink": {
    "Host": "127.0.0.1",
    "Port": 1884
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Expressions",
      "Serilog.Enrichers.WithCaller"
    ],
    "Enrich": [
      {
        "Name": "WithCallerInfo",
        "Args": {
          "includeFileInfo": "true",
          "filePathDepth": 2,
          "assemblyPrefix": "WaveLink."
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "WaveLink.SDK.WaveLinkClient": "Debug",
        "WaveLink.SDK.WaveSocket": "Information",
        "WaveLinkClient.Method": "Information",
        "WaveLinkClient.Response": "Debug",
        "WaveLinkClient.Result": "Information"
      }
    },

    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}:{LineNumber} -- {Message:lj}{NewLine}{Exception}"

        }
      }
    ]

  }
}
